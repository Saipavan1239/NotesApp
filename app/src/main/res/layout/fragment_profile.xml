<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/neutral_bg">

        <!-- HEADER -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_profile_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHeight_percent="0.62">

            <!-- PROFILE IMAGE -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop"
                />

            <!-- BACK BUTTON -->
            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="16dp"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="start|top"
                app:tint="@color/icon_tint" />

            <!-- MENU (REMOVE PHOTO) -->
            <ImageView
                android:id="@+id/menuBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="16dp"
                android:padding="6dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/icon_tint"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="end|top"/>

            <!-- NAME ON IMAGE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/nameOnImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/profile_text"
                    />

                <ImageView
                    android:id="@+id/editNameBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_gravity="center"
                    app:tint="@color/icon_tint"
                    android:src="@drawable/ic_edit"/>
            </LinearLayout>

        </FrameLayout>

        <!-- BOTTOM CONTENT (STRAIGHT TOP, ROUND BOTTOM ONLY) -->

        <!-- SCROLLABLE CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/imageContainer"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/contentCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_profile_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/imageContainer"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- ABOUT TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textSize="16sp"
                    android:textColor="@color/profile_subtext"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>

                <!-- ABOUT ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/aboutTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:text="Writing thoughts, one note at a time."
                        android:textSize="14sp"
                        android:textColor="@color/gray_500"/>

                    <ImageView
                        android:id="@+id/editAboutBtn"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_edit"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- LOGOUT -->
                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/red_500"/>
            </LinearLayout>


        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
